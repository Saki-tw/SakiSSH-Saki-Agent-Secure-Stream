<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SASS Daemon — macOS launchd 部署範本
  版本: 1.4
  
  安裝方式:
    sudo cp tw.com.saki-studio.sakisshd.plist /Library/LaunchDaemons/
    sudo launchctl load /Library/LaunchDaemons/tw.com.saki-studio.sakisshd.plist
  
  移除方式:
    sudo launchctl unload /Library/LaunchDaemons/tw.com.saki-studio.sakisshd.plist
    sudo rm /Library/LaunchDaemons/tw.com.saki-studio.sakisshd.plist
  
  © 2026 Saki Studio. All rights reserved.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>tw.com.saki-studio.sakisshd</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/sakisshd</string>
        <string>--config</string>
        <string>/etc/sass/sakisshd.toml</string>
    </array>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    
    <key>StandardOutPath</key>
    <string>/var/log/sass/sakisshd.log</string>
    
    <key>StandardErrorPath</key>
    <string>/var/log/sass/sakisshd.error.log</string>
    
    <key>WorkingDirectory</key>
    <string>/var/lib/sass</string>
    
    <key>UserName</key>
    <string>_sass</string>
    
    <key>GroupName</key>
    <string>_sass</string>
    
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>SASS_LOG_LEVEL</key>
        <string>info</string>
        <key>SASS_TLS_CERT</key>
        <string>/etc/sass/tls/cert.pem</string>
        <key>SASS_TLS_KEY</key>
        <string>/etc/sass/tls/key.pem</string>
    </dict>
</dict>
</plist>
